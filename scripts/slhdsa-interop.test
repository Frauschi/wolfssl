#!/usr/bin/env bash
# slhdsa-interop.test
#
# Per-variant interop driver for the twelve SLH-DSA parameter sets
# (six SHAKE + six SHA-2). Exercises the wolfSSL cert-layer end-to-end
# (key-gen -> mint self-signed cert -> ParseCert -> ConfirmSignature)
# once per variant via wolfcrypt/test/slhdsa_interop_one. PASS/FAIL is
# genuinely per-variant: each variant runs in its own process and emits
# a single line of result.
#
# Optional cross-stack probe against OpenSSL+oqs-provider when
# OQS_PROVIDER=1 is set. Note: this is a capability probe (algorithm
# registered in `openssl list -signature-algorithms`), not a full TLS
# handshake. Real handshake interop requires test certs minted by both
# stacks and is out of scope for this script.
#
# Exits 0 if every wolfSSL-side variant either PASSes or is logged as
# SKIP-LOCAL (variant not compiled in). External skips never fail.
#
# Build-tree layout: the helper binary may live in $builddir (out-of-tree
# build) or under the source root (in-tree). We honour the standard
# automake $builddir / $srcdir env vars when set; otherwise we infer
# in-tree from the script's own location.

set -u

if [ -n "${builddir:-}" ]; then
    BUILD_DIR="${builddir}"
elif [ -n "${top_builddir:-}" ]; then
    BUILD_DIR="${top_builddir}"
else
    BUILD_DIR="$(cd "$(dirname "$0")/.." && pwd)"
fi
if [ -n "${srcdir:-}" ]; then
    SRC_DIR="${srcdir}"
elif [ -n "${top_srcdir:-}" ]; then
    SRC_DIR="${top_srcdir}"
else
    SRC_DIR="$(cd "$(dirname "$0")/.." && pwd)"
fi

# Run from the source root so the helper finds certs/slhdsa/ via the
# relative paths embedded in test_wc_slhdsa_der_decode_files (kept here
# for parity even though slhdsa_interop_one itself does not read fixtures).
cd "${SRC_DIR}"

VARIANTS=(
    shake_128s shake_128f shake_192s shake_192f shake_256s shake_256f
    sha2_128s  sha2_128f  sha2_192s  sha2_192f  sha2_256s  sha2_256f
)

INTEROP_ONE="${BUILD_DIR}/wolfcrypt/test/slhdsa_interop_one"
LOG_DIR="$(mktemp -d)"
trap 'rm -rf "${LOG_DIR}"' EXIT

# Counters live in this shell's variable scope. The note_* helpers below
# mutate them in place; callers must NOT wrap stages in a subshell
# (e.g. `( … ) | tee log`) or the counters will silently reset.
pass=0
fail=0
skipped_local=0
skipped_external=0
probe_ok=0
declare -a fail_list=()

note_pass()           { pass=$((pass + 1)); printf '  PASS:           %s\n' "$1"; }
note_fail()           { fail=$((fail + 1)); fail_list+=("$1"); printf '  FAIL:           %s\n' "$1"; }
note_skip_local()     { skipped_local=$((skipped_local + 1)); printf '  SKIP-LOCAL:     %s\n' "$1"; }
note_skip_external()  { skipped_external=$((skipped_external + 1)); printf '  SKIP-EXTERNAL:  %s\n' "$1"; }
note_probe_ok()       { probe_ok=$((probe_ok + 1)); printf '  PROBE-OK:       %s\n' "$1"; }

if [ ! -x "${INTEROP_ONE}" ]; then
    echo "ERROR: ${INTEROP_ONE} missing or not executable -- did you build?" >&2
    echo "Run: ./configure --enable-slhdsa=yes,sha2 --enable-experimental \\" >&2
    echo "                 --enable-certgen --enable-keygen && make" >&2
    exit 1
fi

echo "============================================================"
echo "  SLH-DSA cert-layer interop - per-variant"
echo "  log dir:    ${LOG_DIR}"
echo "  helper:     ${INTEROP_ONE}"
echo "============================================================"

# ----- Stage 1: per-variant cert mint + verify ------------------------
echo "[1/2] wolfSSL cert mint + ConfirmSignature (one process per variant)"
for v in "${VARIANTS[@]}"; do
    log="${LOG_DIR}/${v}.log"
    "${INTEROP_ONE}" "${v}" >"${log}" 2>&1
    rc=$?
    case "${rc}" in
        0)  note_pass "${v}" ;;
        77) note_skip_local "${v}: $(tail -n 1 "${log}")" ;;
        99) # Hard framework error (helper invoked wrong); abort.
            echo "  framework error from helper: rc=99" >&2
            cat "${log}" >&2
            exit 1
            ;;
        *)  note_fail "${v} (rc=${rc}): $(tail -n 1 "${log}")" ;;
    esac
done

# ----- Stage 2: oqs-provider capability probe (optional) --------------
echo "[2/2] OpenSSL+oqs-provider algorithm registration probe"
if [ -z "${OQS_PROVIDER:-}" ]; then
    echo "  OQS_PROVIDER unset -- skipping oqs-provider probe"
    for v in "${VARIANTS[@]}"; do
        note_skip_external "${v}: probe not requested (set OQS_PROVIDER=1)"
    done
else
    OPENSSL_BIN="${OPENSSL:-openssl}"
    if ! command -v "${OPENSSL_BIN}" >/dev/null; then
        for v in "${VARIANTS[@]}"; do
            note_skip_external "${v}: ${OPENSSL_BIN} not in PATH"
        done
    else
        ver="$("${OPENSSL_BIN}" version 2>/dev/null || echo unknown)"
        prov="$("${OPENSSL_BIN}" list -providers 2>/dev/null | \
                grep -iE 'oqsprovider|oqs.*provider' || true)"
        if [ -z "${prov}" ]; then
            for v in "${VARIANTS[@]}"; do
                note_skip_external "${v}: oqs-provider absent (${ver})"
            done
        else
            algs="$("${OPENSSL_BIN}" list -signature-algorithms 2>/dev/null || true)"
            for v in "${VARIANTS[@]}"; do
                hash="${v%%_*}"          # shake or sha2
                size="${v##*_}"          # 128s, 128f, 192s, ...
                lvl="${size%[sf]}"       # 128, 192, 256
                tail="${size: -1}"       # s or f
                alg="sphincs${hash}${lvl}${tail}simple"
                if printf '%s\n' "${algs}" | grep -qi "${alg}"; then
                    note_probe_ok "${v} -> ${alg}"
                else
                    note_skip_external "${v}: oqs-provider lacks ${alg} (${ver})"
                fi
            done
        fi
    fi
fi

echo "============================================================"
printf '  Summary: %d PASS, %d FAIL, %d SKIP-LOCAL, %d PROBE-OK, %d SKIP-EXTERNAL\n' \
    "${pass}" "${fail}" "${skipped_local}" "${probe_ok}" "${skipped_external}"
total=$((pass + fail + skipped_local + probe_ok + skipped_external))
expected=$((${#VARIANTS[@]} * 2))
if [ "${total}" -ne "${expected}" ]; then
    echo "  WARN: expected ${expected} per-variant outcomes, counted ${total}" >&2
fi
echo "============================================================"
if [ "${fail}" -gt 0 ]; then
    printf '  Failures:\n'
    for f in "${fail_list[@]}"; do printf '    - %s\n' "$f"; done
    exit 1
fi
exit 0
